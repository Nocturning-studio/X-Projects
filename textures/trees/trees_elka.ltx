[material_configuration]
	use_alpha_test = true
	alpha_test_type = alpha_hashed
	use_displacement = false
	displacement_type = none
	use_custom_material = true
	vertex_shader = default
	pixel_shader = default
	use_detail_map = false

[albedo_configuration]
	color_space = srgb

[wind_configuration]
	use_wind = true
	wind_type = branchcard
	use_both_axis_as_weight = true
	invert_weight_axis = true