--================================================================================================
-- xr_box.script
-- Скрипт, управляющий выпадением лута из разбиваемых ящиков (физических объектов).
-- Исправления:
-- 1. Увеличена высота спавна предметов (+0.6м), чтобы они не проваливались под пол.
-- 2. Добавлен горизонтальный разброс, чтобы предметы не спавнились друг в друге.
-- 3. Исправлена ошибка области видимости переменных (nil check) при выборе комьюнити ящика.
--================================================================================================

-- Таблица, где ключ — группировка (тип ящика), а значение — список возможных предметов и их шансов.
local item_by_community = {}

-- Таблицы множителей и диапазонов количества предметов в зависимости от уровня и сложности.
local mul_by_level = {}
local count_by_level = {}

-- Список секций патронов (для них может использоваться отдельная логика спавна пачек).
local ammo_sections = {}

-- Загружаем конфиг с настройками лута
local death_ini = ini_file("misc\\ph_box_generic.ltx")

-- Объявляем класс
class "ph_item_box"

-- Конструктор класса. Вызывается один раз при инициализации скрипта для объекта.
function ph_item_box:__init(obj)
	self.obj = obj

	-- Список типов ящиков, которые описаны в ltx файле
	local community_list = { "def_box", "small_box_generic", "small_box_ussr", "small_box_nato", "small_box_army", "small_box_science", "big_box_generic", "big_box_dungeons", "big_box_arsenal"}	
	
	-- Заполняем таблицу item_by_community данными из конфига
	for k,v in pairs(community_list) do
        item_by_community[v] = {}
        if death_ini:section_exist(v) then
		    local n = death_ini:line_count(v)
		    local id, value = "", ""
		    for i=0,n-1 do
			    result, id, value = death_ini:r_line(v,i,"","")
			    -- Сохраняем шанс выпадения (умножаем на 100 для удобства работы с math.random)
                item_by_community[v][id] = 100 * tonumber(value)
		    end
        end
    end
 
	-- Определяем текущий уровень, чтобы загрузить специфичные для локации множители
    local level_name = level.name()
	if not death_ini:section_exist(level_name) then
		level_name = "default" -- Если для уровня нет настроек, используем дефолтные
	end

    -- Читаем множители для уровня
    local n = death_ini:line_count(level_name)
	local id, value = "", ""
	for i=0,n-1 do
		result, id, value = death_ini:r_line(level_name,i,"","")
        mul_by_level[id] = tonumber(value)
	end        

    -- Читаем настройки количества предметов в зависимости от сложности игры
    local item_count_section = "item_count_" .. level.get_game_difficulty()
    local n = death_ini:line_count(item_count_section)
	for i=0,n-1 do
		result, id, value = death_ini:r_line(item_count_section,i,"","")
        
        -- Парсим строку вида "1,3" (мин, макс)
        local t = parse_nums(value)
		if t[1] == nil then
            abort("Error on [death_ini] declaration. Section [%s], line [%s]", item_count_section, tostring(id))
        end
        local min = t[1]
        local max = t[2]
        if max == nil then
            max = min
        end
        
        if mul_by_level[id] == nil then
            mul_by_level[id] = 0
        end

        -- Применяем множитель уровня к количеству предметов
        min = tonumber(min) * mul_by_level[id]
        max = tonumber(max) * mul_by_level[id]

        count_by_level[id] = {min = min, max = max}
	end        
    
	-- Заполняем список патронов
    ammo_sections = {}
    local n = death_ini:line_count("ammo_sections")
	local id, value = "", ""
	for i=0,n-1 do
		result, id, value = death_ini:r_line("ammo_sections",i,"","")
        ammo_sections[id] = true
	end        
end

-- Основная функция спавна вещей. Вызывается при разрушении ящика.
function ph_item_box:spawn_items()
	local spawn_items = {}
	local ini = self.obj:spawn_ini()
	
	-- Читаем custom data объекта (из SDK), чтобы узнать тип ящика (community)
	local community	= utils.cfg_get_string(ini, "drop_box", "community", self.obj, false, "", "def_box")
	
	-- Если в custom data прописан конкретный список предметов (параметр items), спавним только их
    if r_items(ini, "drop_box", "items") ~= nil then
		local items = r_items(ini, "drop_box", "items")
		for k,v in pairs(items) do
			create_obligatory_items(self.obj, v.section, v.count)
		end
		return -- Выходим, рандомный лут не нужен
	end
			
    -- Получаем список возможного лута для данного типа ящика
    local spawn_items = item_by_community[community]
	
	-- [ИСПРАВЛЕНИЕ БАГА]: Раньше здесь создавалась локальная переменная, перекрывающая основную.
	if spawn_items == nil then 
		printf("xr_box: wrong community -- %s setting default def_box ", community)
		spawn_items = item_by_community["def_box"] -- Теперь корректно назначаем дефолтную таблицу
	end
    
    -- Перебираем все возможные предметы для этого ящика
    for k,v in pairs(spawn_items) do		
		-- Рассчитываем количество (min/max зависит от сложности игры)
		local number = math.ceil(math.random(count_by_level[k].min, count_by_level[k].max))
		-- Вызываем функцию создания предметов
		create_items(self.obj, k, number, v)			
    end
end	

-- Функция непосредственного создания объектов в мире
function create_items(obj, section, number, rnd)
    -- Получаем позицию ящика
    local pos = obj:position()
    
    -- Разделяем логику для патронов и обычных предметов
    if ammo_sections[section] == true then
		-- Проверяем шанс выпадения (rnd)
		if math.random(100) <= rnd	then	
			if number > 0 then
				-- [ИСПРАВЛЕНИЕ СПАВНА]:
				local position = vector():set(0,0,0)
				-- 1. Добавляем случайное смещение по X и Z (+/- 20см), чтобы предметы не слипались
				position.x = pos.x + math.random(-20,20)/100
				position.z = pos.z + math.random(-20,20)/100
				-- 2. Поднимаем высоту на 0.6 метра. Это ключевой фикс проваливания под текстуры.
				position.y = pos.y + 0.6 

				-- Создаем патроны через специальную функцию (поддерживает количество в пачке)
				se_respawn.create_ammo(section,	
					    position,
						obj:level_vertex_id(),	
						obj:game_vertex_id(),
						65535,
						number)
			end
		end
    else
        -- Логика для обычных предметов (аптечки, еда, артефакты)
        for i=1,number do
            if math.random(100) <= rnd then
				-- [ИСПРАВЛЕНИЕ СПАВНА]: То же самое для обычных предметов
				local position = vector():set(0,0,0)
				position.x = pos.x + math.random(-20,20)/100
				position.z = pos.z + math.random(-20,20)/100
				position.y = pos.y + 0.6 -- Безопасная высота

				alife():create(section,	
					    position,
						obj:level_vertex_id(),	
						obj:game_vertex_id())
			end
        end
    end    
end

-- Вспомогательная функция для парсинга имен из строки
function parse_names( s )
    local t = {}
    for name in string.gfind( s, "([%w_%-.\\]+)%p*" ) do
        table.insert( t, name )
    end
    return t
end

-- Функция чтения списка предметов из spawn_ini
function r_items( spawn_ini, section, line)
	if spawn_ini:line_exist( section, line ) then
		local t = parse_names( spawn_ini:r_string( section, line ) )
		local n = table.getn( t )
		
		local ret_table = {}
		local k = 1
		while k <= n do
			local item = {}
			item.section = t[k]
			-- Если есть следующее значение и это число - это количество
			if t[k+1] ~= nil then
				local p = tonumber(t[k+1])
				if p then
					item.count = p
					k = k + 2
				else
					item.count = 1
					k = k + 1
				end
			else
				item.count	 = 1
				k = k + 1
			end
			table.insert(ret_table, item)	
		end
		return ret_table
	end
	return nil
end

-- Функция для создания обязательных предметов (из SDK)
function create_obligatory_items(obj, item , count)
	local pos = obj:position()
	for i = 1,count do
		-- [ИСПРАВЛЕНИЕ СПАВНА]: Обязательные предметы тоже должны спавниться безопасно
		local position = vector():set(0,0,0)
		position.x = pos.x + math.random(-20,20)/100
		position.z = pos.z + math.random(-20,20)/100
		position.y = pos.y + 0.6 -- Поднимаем на 60 см

		alife():create(item,	
				position,
				obj:level_vertex_id(),	
				obj:game_vertex_id())
	end
end
